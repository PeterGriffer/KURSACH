{
  "name": "kursovaya-website",
  "version": "1.0.0",
  "description": "Website project with Docker and CI/CD",
  "scripts": {
    "dev": "live-server src --port=3000",
    "build": "echo 'Build process would go here'",
    "build:docker": "docker build -t kursovaya-website .",
    "test": "echo 'Tests would run here'",
    "test:lint": "echo 'Linting would run here'",
    "docker:compose": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "ci:validate": "npm run test:lint && npm run docker:build",
    "clean": "echo 'Clean would run here'"
  },
  "devDependencies": {
    "live-server": "^1.2.2"
  },
  "dependencies": {}
}